{
  "type": "object",
  "required": ["step"],
  "additionalProperties": false,
  "properties": {
    "step": {
      "anyOf": [
        {
          "type": "object",
          "required": ["action", "toolCalls"],
          "additionalProperties": false,
          "properties": {
            "action": {
              "enum": ["tool_calls"]
            },
            "toolCalls": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": ["name", "arguments"],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "enum": ["resolve_entity"]
                      },
                      "arguments": {
                        "type": "object",
                        "required": ["mention"],
                        "additionalProperties": false,
                        "properties": {
                          "mention": {
                            "type": "string"
                          },
                          "entityType": {
                            "type": "string",
                            "enum": ["person", "tier", "ort", "organisation", "objekt", "konzept"]
                          },
                          "contextIds": {
                            "type": "array",
                            "maxItems": 12,
                            "items": {
                              "type": "string"
                            }
                          },
                          "vocabulary": {
                            "type": "array",
                            "maxItems": 32,
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["name", "arguments"],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "enum": ["get_entity"]
                      },
                      "arguments": {
                        "type": "object",
                        "required": ["elementId"],
                        "additionalProperties": false,
                        "properties": {
                          "elementId": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["name", "arguments"],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "enum": ["get_relationships"]
                      },
                      "arguments": {
                        "type": "object",
                        "required": ["elementId"],
                        "additionalProperties": false,
                        "properties": {
                          "elementId": {
                            "type": "string"
                          },
                          "otherElementId": {
                            "type": "string"
                          },
                          "limit": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 12
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["name", "arguments"],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "enum": ["find_timeline_events"]
                      },
                      "arguments": {
                        "type": "object",
                        "required": [],
                        "additionalProperties": false,
                        "properties": {
                          "query": {
                            "type": "string"
                          },
                          "entityId": {
                            "type": "string"
                          },
                          "limit": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 12
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["name", "arguments"],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "enum": ["get_world_state"]
                      },
                      "arguments": {
                        "type": "object",
                        "required": ["momentId"],
                        "additionalProperties": false,
                        "properties": {
                          "momentId": {
                            "type": "string"
                          },
                          "phase": {
                            "type": "string",
                            "enum": ["before", "at", "after"]
                          },
                          "entityIds": {
                            "type": "array",
                            "maxItems": 12,
                            "items": {
                              "type": "string"
                            }
                          },
                          "relationshipIds": {
                            "type": "array",
                            "maxItems": 12,
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["name", "arguments"],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "enum": ["search_manuscript"]
                      },
                      "arguments": {
                        "type": "object",
                        "required": ["query"],
                        "additionalProperties": false,
                        "properties": {
                          "query": {
                            "type": "string"
                          },
                          "chapterIds": {
                            "type": "array",
                            "maxItems": 32,
                            "items": {
                              "type": "string"
                            }
                          },
                          "limit": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 8
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["action", "final"],
          "additionalProperties": false,
          "properties": {
            "action": {
              "enum": ["final"]
            },
            "final": {
              "type": "object",
              "required": ["message", "citations", "proposals"],
              "additionalProperties": false,
              "properties": {
                "message": {
                  "type": "string"
                },
                "citations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "proposals": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "required": ["kind", "tempId", "element"],
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "enum": ["create_element"]
                          },
                          "tempId": {
                            "type": "string",
                            "pattern": "^new:.*$"
                          },
                          "element": {
                            "type": "object",
                            "required": ["name"],
                            "additionalProperties": false,
                            "properties": {
                              "type": {
                                "enum": [
                                  "person",
                                  "tier",
                                  "ort",
                                  "organisation",
                                  "objekt",
                                  "konzept"
                                ]
                              },
                              "name": {
                                "type": "string"
                              },
                              "label": {
                                "type": "string"
                              },
                              "sub": {
                                "type": "string"
                              },
                              "profile": {
                                "type": "object",
                                "required": [],
                                "additionalProperties": false,
                                "properties": {
                                  "alter": {
                                    "type": "string"
                                  },
                                  "rolle": {
                                    "type": "string"
                                  },
                                  "aussehen": {
                                    "type": "string"
                                  },
                                  "herkunft": {
                                    "type": "string"
                                  },
                                  "stimme": {
                                    "type": "string"
                                  },
                                  "notes": {
                                    "type": "string"
                                  }
                                }
                              },
                              "aliases": {
                                "type": "array",
                                "maxItems": 16,
                                "items": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": ["kind", "elementId", "patch"],
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "enum": ["update_element"]
                          },
                          "elementId": {
                            "type": "string"
                          },
                          "patch": {
                            "type": "object",
                            "required": [],
                            "additionalProperties": false,
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "label": {
                                "type": "string"
                              },
                              "sub": {
                                "type": "string"
                              },
                              "profile": {
                                "type": "object",
                                "required": [],
                                "additionalProperties": false,
                                "properties": {
                                  "alter": {
                                    "type": "string"
                                  },
                                  "rolle": {
                                    "type": "string"
                                  },
                                  "aussehen": {
                                    "type": "string"
                                  },
                                  "herkunft": {
                                    "type": "string"
                                  },
                                  "stimme": {
                                    "type": "string"
                                  },
                                  "notes": {
                                    "type": "string"
                                  }
                                }
                              },
                              "aliases": {
                                "type": "array",
                                "maxItems": 16,
                                "items": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": ["kind", "tempId", "moment"],
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "enum": ["create_timeline_moment"]
                          },
                          "tempId": {
                            "type": "string",
                            "pattern": "^new:.*$"
                          },
                          "moment": {
                            "type": "object",
                            "required": ["title"],
                            "additionalProperties": false,
                            "properties": {
                              "title": {
                                "type": "string"
                              },
                              "date": {
                                "type": "string"
                              },
                              "note": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": ["kind", "relationship"],
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "enum": ["create_relationship"]
                          },
                          "relationship": {
                            "type": "object",
                            "required": [
                              "from",
                              "to",
                              "label",
                              "directed",
                              "lineStyle",
                              "relationshipKind",
                              "color"
                            ],
                            "additionalProperties": false,
                            "properties": {
                              "from": {
                                "type": "string"
                              },
                              "to": {
                                "type": "string"
                              },
                              "label": {
                                "type": "string"
                              },
                              "directed": {
                                "type": "boolean"
                              },
                              "lineStyle": {
                                "enum": ["solid", "dashed", "dotted"]
                              },
                              "relationshipKind": {
                                "enum": ["general", "kinship"]
                              },
                              "color": {
                                "enum": ["auto", "ink", "gold", "rose", "moss", "blue"]
                              }
                            }
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": ["kind", "relationshipId", "momentId", "patch"],
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "enum": ["set_relationship_at_moment"]
                          },
                          "relationshipId": {
                            "type": "string"
                          },
                          "momentId": {
                            "type": "string"
                          },
                          "patch": {
                            "type": "object",
                            "required": [],
                            "additionalProperties": false,
                            "properties": {
                              "label": {
                                "type": "string"
                              },
                              "active": {
                                "type": "boolean"
                              },
                              "directed": {
                                "type": "boolean"
                              },
                              "lineStyle": {
                                "enum": ["solid", "dashed", "dotted"]
                              },
                              "relationshipKind": {
                                "enum": ["general", "kinship"]
                              },
                              "color": {
                                "enum": ["auto", "ink", "gold", "rose", "moss", "blue"]
                              }
                            }
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": ["kind", "elementId", "momentId"],
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "enum": ["mark_deceased"]
                          },
                          "elementId": {
                            "type": "string"
                          },
                          "momentId": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": ["kind", "strategy"],
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "enum": ["arrange_elements"]
                          },
                          "strategy": {
                            "enum": ["thematic", "grid"]
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": ["kind", "elementId", "placeId"],
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "enum": ["set_presence"]
                          },
                          "elementId": {
                            "type": "string"
                          },
                          "placeId": {
                            "type": "string"
                          },
                          "momentId": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
