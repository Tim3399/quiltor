node_modules/
*.tsbuildinfo
__pycache__/
*.py[cod]
/target/

# pip wheel/sdist build output (produced by `python -m build --outdir pkg-dist`)
pkg-dist/

# Desktop-app build tooling: a local venv and PyInstaller's own work/output dirs,
# all reproducible from the direct target scripts under distribution/desktop/.
.venv-desktop/
distribution/.build/
distribution/artifacts/

# Private world data never belongs in the public application repository.
data/**/*.sqlite3
data/**/*.sqlite3-shm
data/**/*.sqlite3-wal
data/worlds/*
data/history/*
data/manuscripts/*
data/profiles/*
!data/worlds/.gitkeep
!data/history/.gitkeep
!data/manuscripts/.gitkeep
!data/profiles/.gitkeep

# Credentials for the backup service (quiltor.infrastructure.backup.login). Only part
# of data/ is ignored above, so this file needs an explicit entry: it contains secrets.
data/backup-login.json
test-results/
playwright-report/
reports/assistant-eval/*.json
data/llama-server.log
data/mlx-server.log
data/llama-embed.log
# Locally installed writing resources; the old path stays ignored until every
# existing checkout has completed the one-time migration.
data/writing-assistance/
data/language/

# Automatic backups; remove this rule only if they should be versioned explicitly.
data/backups/*
!data/backups/.gitkeep

# Operating-system and editor files
.DS_Store
Thumbs.db
.idea/

# Web-demo secrets (Keycloak client secret etc.) — never committed.
.env

# Local AI working notes/plans/memory — not part of the shipped project.
/ai/
/.claude/worktrees
/.claude/*.local.json
/.claude/*.lock

# Platform runtimes and model weights are attached to release packages, not Git.
runtime/*
!runtime/README.md
models/*.gguf
models/embed/
models/mlx/*
!models/mlx/.gitkeep
