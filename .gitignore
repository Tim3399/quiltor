node_modules/
*.tsbuildinfo
__pycache__/
*.py[cod]

# Private world data never belongs in the public application repository.
data/**/*.sqlite3
data/**/*.sqlite3-shm
data/**/*.sqlite3-wal
data/worlds/*
data/repositories/*
data/manuscripts/*
data/profiles/*
!data/worlds/.gitkeep
!data/repositories/.gitkeep
!data/manuscripts/.gitkeep
!data/profiles/.gitkeep
test-results/
playwright-report/
data/llama-server.log
data/mlx-server.log

# Automatische Sicherungen — bei Bedarf auskommentieren, wenn du sie
# doch mitversionieren willst
data/backups/*
!data/backups/.gitkeep

# Betriebssystem-Kram
.DS_Store
Thumbs.db

# Local AI working notes/plans/memory — not part of the shipped project.
/ai/

# Platform runtimes and model weights are attached to release packages, not Git.
runtime/*
!runtime/README.md
models/*.gguf
models/mlx/*
!models/mlx/.gitkeep
