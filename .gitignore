node_modules/
*.tsbuildinfo
__pycache__/
*.py[cod]
/target/

# pip wheel/sdist build output (produced by `python -m build --outdir pkg-dist`)
pkg-dist/

# Desktop-app build tooling: a local venv and PyInstaller's own work/output dirs,
# all reproducible from the direct target scripts under distribution/desktop/.
.venv-desktop/
distribution/.build/
distribution/artifacts/

# Private world data never belongs in the public application repository.
data/**/*.sqlite3
data/**/*.sqlite3-shm
data/**/*.sqlite3-wal
data/worlds/*
data/history/*
data/manuscripts/*
data/profiles/*
!data/worlds/.gitkeep
!data/history/.gitkeep
!data/manuscripts/.gitkeep
!data/profiles/.gitkeep

# Die Zugangsdaten für den Backup-Dienst (quiltor.infrastructure.backup.login). data/ ist
# oben nur teilweise ignoriert, also muss diese Datei einzeln genannt werden --
# und sie ist die eine hier, die ein echtes Geheimnis enthält.
data/backup-login.json
test-results/
playwright-report/
reports/assistant-eval/*.json
data/llama-server.log
data/mlx-server.log
data/llama-embed.log
# Locally installed writing resources; the old path stays ignored until every
# existing checkout has completed the one-time migration.
data/writing-assistance/
data/language/

# Automatische Sicherungen — bei Bedarf auskommentieren, wenn du sie
# doch mitversionieren willst
data/backups/*
!data/backups/.gitkeep

# Betriebssystem-Kram
.DS_Store
Thumbs.db
.idea/

# Web-Demo secrets (Keycloak client secret etc.) — never versioniert.
.env

# Local AI working notes/plans/memory — not part of the shipped project.
/ai/
/.claude/worktrees
/.claude/*.local.json
/.claude/*.lock

# Platform runtimes and model weights are attached to release packages, not Git.
runtime/*
!runtime/README.md
models/*.gguf
models/embed/
models/mlx/*
!models/mlx/.gitkeep
