// markdownlint-cli2 configuration. Prettier owns formatting (`npm run check:format:docs`), so
// the rules that only describe layout are off; the structural rules stay on.
{
  "gitignore": true,
  "globs": ["**/*.md"],
  "ignores": [
    // Vendored and build output.
    "**/node_modules/**",
    "dist/**",
    // Generated by team/sync.mjs from team/roles; the same files are excluded from Prettier
    // (.prettierignore). The generator writes them, so fixes belong in its templates, not here.
    ".claude/agents/**",
    ".claude/output-styles/**",
    "team/roles/**",
    // German manuscripts a test feeds to the importer. They are author material and serve as
    // input (CLAUDE.md, "The German half"), so their structure, such as a second `#` chapter, is
    // deliberate and not a documentation defect.
    "tests/fixtures/manuscript-import/**"
  ],
  "config": {
    "default": true,
    // Line length: Prettier keeps prose lines as written (it never rewraps), and long table
    // rows and URLs cannot be wrapped at all; a fixed limit would only produce noise.
    "MD013": false,
    // Table column alignment: Prettier formats tables and pads every cell, which this rule
    // (MD060) reads as a different style.
    "MD060": false,
    // Headings repeated under different parents are fine (for example "Formats" per area).
    "MD024": { "siblings_only": true },
    // Headings here are often full sentences; only separators that cannot end a sentence count.
    "MD026": { "punctuation": ",;:" },
    // The only inline HTML is `<a id="...">`, which creates the named anchors other documents
    // link to. Markdown has no syntax for an explicit anchor.
    "MD033": { "allowed_elements": ["a"] },
    // A bold line on its own is a tagline or a version/status line here, not a pseudo-heading.
    "MD036": false
  }
}
