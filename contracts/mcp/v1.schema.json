{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quiltor.app/contracts/mcp/v1.schema.json",
  "title": "Quiltor MCP tool catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "protocolVersion", "tools"],
  "properties": {
    "version": { "const": 1 },
    "protocolVersion": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "effect", "inputSchema", "example"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "effect": { "enum": ["read", "proposal"] },
          "inputSchema": { "type": "object" },
          "example": { "type": "object" }
        }
      }
    }
  }
}
