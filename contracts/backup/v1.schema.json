{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quiltor.app/contracts/backup/v1.schema.json",
  "title": "Quiltor content-addressed backup snapshot v1 (legacy read contract)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "encryption",
    "created",
    "world",
    "title",
    "message",
    "parent",
    "files",
    "id"
  ],
  "properties": {
    "format": { "const": 1 },
    "encryption": { "const": "none" },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|[+-][0-9]{2}:[0-9]{2})?$"
    },
    "world": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "title": { "type": "string", "maxLength": 500 },
    "message": { "type": "string", "maxLength": 4000 },
    "parent": { "type": "string", "pattern": "^(?:|[0-9a-f]{64})$" },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 20001,
      "required": ["world.sqlite3"],
      "properties": {
        "world.sqlite3": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "patternProperties": {
        "^(?:manuscripts|profiles)/[^/\\\\]+\\.md$": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
