{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quiltor.app/contracts/persistence/sqlite-migrations/v1.schema.json",
  "title": "Quiltor SQLite forward-migration chain contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "baselineSchemaVersion",
    "currentSchemaVersion",
    "direction",
    "steps"
  ],
  "properties": {
    "contract": { "const": "quiltor.sqlite-migrations" },
    "version": { "const": 1 },
    "baselineSchemaVersion": { "type": "integer", "minimum": 1 },
    "currentSchemaVersion": { "type": "integer", "minimum": 1 },
    "direction": { "const": "forward-only" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "guarantees"],
        "properties": {
          "from": { "type": "integer", "minimum": 1 },
          "to": { "type": "integer", "minimum": 2 },
          "guarantees": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 5 }
          }
        }
      }
    }
  }
}
