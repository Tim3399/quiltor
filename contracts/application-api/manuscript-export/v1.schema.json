{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quiltor.app/contracts/application-api/manuscript-export/v1.schema.json",
  "title": "Manuscript DOCX export v1",
  "oneOf": [
    {
      "$ref": "#/$defs/previewRequest"
    },
    {
      "$ref": "#/$defs/previewResponse"
    },
    {
      "$ref": "#/$defs/downloadRequest"
    }
  ],
  "$defs": {
    "warningCode": {
      "type": "string",
      "enum": ["notes", "references", "folders", "excluded_chapters", "extensions"]
    },
    "previewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset"],
      "properties": {
        "preset": {
          "type": "string",
          "enum": ["editor", "normseite"]
        }
      }
    },
    "previewResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "preview"],
      "properties": {
        "ok": {
          "const": true
        },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preset",
            "revision",
            "sourceSha256",
            "fileName",
            "chapters",
            "counts",
            "warnings"
          ],
          "properties": {
            "preset": {
              "type": "string",
              "enum": ["editor", "normseite"]
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sourceSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "fileName": {
              "enum": ["Quiltor-Manuskript.docx", "Quiltor-Normseite.docx"]
            },
            "chapters": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "words", "excerpt"],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "words": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "excerpt": {
                    "type": "string",
                    "maxLength": 280
                  }
                }
              }
            },
            "counts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "manuscriptChapters",
                "manuscriptWords",
                "exportedChapters",
                "exportedWords"
              ],
              "properties": {
                "manuscriptChapters": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "manuscriptWords": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "exportedChapters": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "exportedWords": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "warnings": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "count"],
                "properties": {
                  "code": {
                    "$ref": "#/$defs/warningCode"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              }
            }
          }
        }
      }
    },
    "downloadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "revision", "sourceSha256", "acknowledgedWarnings"],
      "properties": {
        "preset": {
          "type": "string",
          "enum": ["editor", "normseite"]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "acknowledgedWarnings": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/warningCode"
          }
        }
      }
    }
  }
}
