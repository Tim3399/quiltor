{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quiltor.app/contracts/application-api/project-transfer/v1.schema.json",
  "title": "Quiltor portable project manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "title", "exportedAt", "includes", "documents", "images"],
  "properties": {
    "format": { "const": "quiltor-project" },
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "exportedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+Z$" },
    "includes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trash", "history"],
      "properties": {
        "trash": { "const": true },
        "history": { "const": false }
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manuscript", "figures", "storyboards"],
      "properties": {
        "manuscript": { "$ref": "#/$defs/manuscriptEnvelope" },
        "figures": { "$ref": "#/$defs/figuresEnvelope" },
        "storyboards": { "$ref": "#/$defs/storyboardsEnvelope" }
      }
    },
    "images": {
      "type": "array",
      "maxItems": 255,
      "items": { "$ref": "#/$defs/image" }
    }
  },
  "$defs": {
    "manuscriptEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "version", "payload"],
      "properties": {
        "contract": { "const": "quiltor.manuscript" },
        "version": { "const": 1 },
        "payload": { "$ref": "../manuscript/v1.schema.json#/$defs/manuscript" }
      }
    },
    "figuresEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "version", "payload"],
      "properties": {
        "contract": { "const": "quiltor.story-world" },
        "version": { "const": 1 },
        "payload": { "$ref": "../story-world/v1.schema.json#/$defs/storyWorld" }
      }
    },
    "storyboardsEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "version", "payload"],
      "properties": {
        "contract": { "const": "quiltor.storyboards" },
        "version": { "const": 1 },
        "payload": { "$ref": "../storyboards/v1.schema.json#/$defs/storyboards" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "member", "mime", "width", "height", "byteSize"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "member": { "type": "string", "pattern": "^images/[0-9a-f]{64}\\.(png|jpg|webp)$" },
        "mime": { "enum": ["image/png", "image/jpeg", "image/webp"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "byteSize": { "type": "integer", "minimum": 1, "maximum": 10485760 }
      }
    }
  }
}
