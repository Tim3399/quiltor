{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quiltor.app/contracts/application-api/structured-error/v1.schema.json",
  "title": "Quiltor structured error v1",
  "description": "A stable machine-readable error. User-facing text is resolved outside the contract.",
  "type": "object",
  "additionalProperties": true,
  "required": ["code"],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
    },
    "params": {
      "type": "object",
      "additionalProperties": true
    },
    "retryable": { "type": "boolean" }
  }
}
