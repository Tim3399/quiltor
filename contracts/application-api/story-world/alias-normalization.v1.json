{
  "algorithm": "quiltor.story-world.alias-ascii-v1",
  "version": 1,
  "asciiUppercase": { "minimum": 65, "maximum": 90, "lowercaseOffset": 32 },
  "separatorRanges": [
    { "minimum": 0, "maximum": 47 },
    { "minimum": 58, "maximum": 64 },
    { "minimum": 91, "maximum": 94 },
    { "minimum": 96, "maximum": 96 },
    { "minimum": 123, "maximum": 127 }
  ],
  "retainedAscii": "ASCII letters, digits, and underscore",
  "nonAscii": "Preserve every code point without normalization or case folding",
  "separatorOutput": "U+0020",
  "collapseSeparators": true,
  "trimSeparators": true
}
