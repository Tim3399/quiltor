{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quiltor.app/contracts/application-api/manuscript/v1.schema.json",
  "title": "Quiltor manuscript wire envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "payload"],
  "properties": {
    "contract": { "const": "quiltor.manuscript" },
    "version": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "payload": { "$ref": "#/$defs/manuscript" }
  },
  "$defs": {
    "manuscript": {
      "type": "object",
      "additionalProperties": true,
      "required": ["chapters"],
      "properties": {
        "chapters": {
          "type": "array",
          "items": { "$ref": "#/$defs/chapter" }
        },
        "bookLayout": { "$ref": "#/$defs/bookLayout" },
        "structure": { "$ref": "#/$defs/manuscriptStructure" },
        "language": { "const": "de-DE" },
        "grammarMode": { "enum": ["manual", "automatic"] },
        "words": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": true,
                "required": ["w"],
                "properties": {
                  "w": { "type": "string" },
                  "d": { "type": "string" }
                }
              }
            ]
          }
        },
        "activeSymbols": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hiddenElements": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "bookLayout": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "version",
        "preset",
        "pageFormat",
        "pageWidthMm",
        "pageHeightMm",
        "marginInnerMm",
        "marginOuterMm",
        "marginTopMm",
        "marginBottomMm",
        "gutterMm",
        "mirrorMargins",
        "fontFamily",
        "fontSizePt",
        "lineHeight",
        "alignment",
        "hyphenation",
        "firstLineIndent",
        "firstLineIndentEm",
        "paragraphSpacingEm",
        "widows",
        "orphans",
        "chapterStart",
        "chapterTopMm",
        "chapterNumber",
        "chapterNumberStyle",
        "chapterTitle",
        "chapterAlignment",
        "chapterTitleSizePt",
        "dropCap",
        "chapterFirstIndent",
        "sceneSymbol",
        "sceneSpaceBeforeMm",
        "sceneSpaceAfterMm",
        "pageNumbers",
        "pageNumberPosition",
        "hideChapterPageNumbers",
        "hideTitlePageNumber",
        "numberFromFirstChapter",
        "bookTitle",
        "subtitle",
        "author",
        "series",
        "volume",
        "showNovelLabel",
        "showVersion",
        "showDate"
      ],
      "properties": {
        "version": { "const": 1 },
        "preset": { "enum": ["quiltor-novel", "classic-paperback", "a5-manuscript"] },
        "pageFormat": { "enum": ["6x9", "a5", "5.5x8.5", "custom"] },
        "pageWidthMm": { "type": "number", "minimum": 80, "maximum": 500 },
        "pageHeightMm": { "type": "number", "minimum": 80, "maximum": 500 },
        "marginInnerMm": { "type": "number", "minimum": 0, "maximum": 100 },
        "marginOuterMm": { "type": "number", "minimum": 0, "maximum": 100 },
        "marginTopMm": { "type": "number", "minimum": 0, "maximum": 100 },
        "marginBottomMm": { "type": "number", "minimum": 0, "maximum": 100 },
        "gutterMm": { "type": "number", "minimum": 0, "maximum": 50 },
        "mirrorMargins": { "type": "boolean" },
        "fontFamily": {
          "enum": ["eb-garamond", "literata", "source-serif-4", "crimson-pro", "libre-baskerville"]
        },
        "fontSizePt": { "type": "number", "minimum": 6, "maximum": 36 },
        "lineHeight": { "type": "number", "minimum": 0.8, "maximum": 3 },
        "alignment": { "enum": ["justify", "left"] },
        "hyphenation": { "type": "boolean" },
        "firstLineIndent": { "type": "boolean" },
        "firstLineIndentEm": { "type": "number", "minimum": 0, "maximum": 10 },
        "paragraphSpacingEm": { "type": "number", "minimum": 0, "maximum": 10 },
        "widows": { "type": "integer", "minimum": 1, "maximum": 5 },
        "orphans": { "type": "integer", "minimum": 1, "maximum": 5 },
        "chapterStart": { "enum": ["next-page", "right-page"] },
        "chapterTopMm": { "type": "number", "minimum": 0, "maximum": 150 },
        "chapterNumber": { "type": "boolean" },
        "chapterNumberStyle": { "enum": ["number", "padded", "chapter"] },
        "chapterTitle": { "type": "boolean" },
        "chapterAlignment": { "enum": ["left", "center"] },
        "chapterTitleSizePt": { "type": "number", "minimum": 6, "maximum": 72 },
        "dropCap": { "type": "boolean" },
        "chapterFirstIndent": { "type": "boolean" },
        "sceneSymbol": { "type": "string", "maxLength": 32, "pattern": "^(?:$|.*\\S.*)$" },
        "sceneSpaceBeforeMm": { "type": "number", "minimum": 0, "maximum": 100 },
        "sceneSpaceAfterMm": { "type": "number", "minimum": 0, "maximum": 100 },
        "pageNumbers": { "type": "boolean" },
        "pageNumberPosition": { "enum": ["bottom-center", "bottom-outside", "top-outside"] },
        "hideChapterPageNumbers": { "type": "boolean" },
        "hideTitlePageNumber": { "type": "boolean" },
        "numberFromFirstChapter": { "type": "boolean" },
        "bookTitle": { "type": "string", "maxLength": 1000 },
        "subtitle": { "type": "string", "maxLength": 1000 },
        "author": { "type": "string", "maxLength": 1000 },
        "series": { "type": "string", "maxLength": 1000 },
        "volume": { "type": "string", "maxLength": 1000 },
        "showNovelLabel": { "type": "boolean" },
        "showVersion": { "type": "boolean" },
        "showDate": { "type": "boolean" }
      },
      "allOf": [
        {
          "description": "Runtime validators additionally require at least 30 mm of usable width and height after margins."
        }
      ]
    },
    "manuscriptStructure": {
      "type": "object",
      "additionalProperties": true,
      "required": ["folders", "items"],
      "properties": {
        "folders": {
          "type": "array",
          "items": { "$ref": "#/$defs/chapterFolder" }
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/manuscriptTreeItem" }
        }
      }
    },
    "chapterFolder": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "title": { "type": "string", "maxLength": 1000 }
      }
    },
    "manuscriptTreeItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "position"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 500 },
        "kind": { "enum": ["chapter", "folder"] },
        "chapterId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "folderId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "parentFolderId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "position": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "oneOf": [
        {
          "properties": { "kind": { "const": "chapter" } },
          "required": ["chapterId"],
          "not": { "required": ["folderId"] }
        },
        {
          "properties": { "kind": { "const": "folder" } },
          "required": ["folderId"],
          "not": { "required": ["chapterId"] }
        }
      ]
    },
    "chapter": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "title": { "type": "string", "maxLength": 1000 },
        "body": { "type": "string", "maxLength": 10000000 },
        "note": { "type": "string", "maxLength": 100000 },
        "noteReferences": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/noteReference" }
        },
        "noteMarks": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/noteMark" }
        },
        "mentions": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/mention" }
        },
        "marks": {
          "type": "array",
          "items": { "$ref": "#/$defs/mark" }
        },
        "storyTime": {
          "$ref": "#/$defs/storyTime"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["noteReferences"],
            "properties": { "noteReferences": { "minItems": 1 } }
          },
          "then": { "required": ["note"] }
        },
        {
          "if": {
            "required": ["noteMarks"],
            "properties": { "noteMarks": { "minItems": 1 } }
          },
          "then": { "required": ["note"] }
        }
      ]
    },
    "storyTime": {
      "type": "object",
      "additionalProperties": true,
      "required": ["startMomentId"],
      "properties": {
        "startMomentId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "endMomentId": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "noteReference": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "target", "from", "to", "surface"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 500 },
        "target": { "$ref": "#/$defs/worldReferenceTarget" },
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Zero-based UTF-16 code-unit offset at a Unicode scalar boundary."
        },
        "to": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Exclusive UTF-16 code-unit offset at a Unicode scalar boundary."
        },
        "surface": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "noteMark": {
      "type": "object",
      "additionalProperties": true,
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "to": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "kind": { "enum": ["bold", "italic", "heading"] },
        "level": { "type": "integer", "minimum": 1, "maximum": 3 }
      },
      "oneOf": [
        {
          "properties": { "kind": { "enum": ["bold", "italic"] } },
          "not": { "required": ["level"] }
        },
        {
          "properties": { "kind": { "const": "heading" } },
          "required": ["level"]
        }
      ]
    },
    "worldReferenceTarget": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["entity", "place", "timeline", "chapter", "storyboard"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "mention": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "elementId", "from", "to", "surface", "source", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 500 },
        "elementId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Zero-based UTF-16 code-unit offset at a Unicode scalar boundary."
        },
        "to": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Exclusive UTF-16 code-unit offset at a Unicode scalar boundary."
        },
        "surface": { "type": "string", "minLength": 1, "maxLength": 500 },
        "source": { "enum": ["completion", "helper", "deterministic", "llm-assisted"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "mark": {
      "type": "object",
      "additionalProperties": true,
      "required": ["from", "to", "kind"],
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Zero-based UTF-16 code-unit offset at a Unicode scalar boundary."
        },
        "to": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Exclusive UTF-16 code-unit offset at a Unicode scalar boundary."
        },
        "kind": { "enum": ["bold", "italic"] }
      }
    }
  }
}
