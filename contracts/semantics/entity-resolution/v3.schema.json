{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quiltor.app/contracts/semantics/entity-resolution/v3.schema.json",
  "title": "Quiltor entity-resolution golden fixture v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["fold", "distance", "figures", "resolution"],
  "properties": {
    "fold": { "$ref": "./v1.schema.json#/properties/fold" },
    "distance": { "$ref": "./v1.schema.json#/properties/distance" },
    "figures": { "$ref": "./v1.schema.json#/properties/figures" },
    "resolution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mention", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "mention": { "type": "string" },
          "entityType": {
            "enum": ["person", "tier", "ort", "organisation", "objekt", "konzept"]
          },
          "contextIds": { "type": "array", "items": { "type": "string" } },
          "vocabulary": { "type": "array", "items": { "type": "string" } },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "resolvedId", "candidates"],
            "properties": {
              "status": { "enum": ["resolved", "ambiguous", "not_found"] },
              "resolvedId": { "type": ["string", "null"] },
              "candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["elementId", "score", "reasons"],
                  "properties": {
                    "elementId": { "type": "string", "minLength": 1 },
                    "score": { "type": "number", "minimum": 0, "maximum": 1 },
                    "reasons": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "exact_id",
                          "exact_name",
                          "exact_alias",
                          "fuzzy_name",
                          "fuzzy_alias",
                          "type_match",
                          "local_context",
                          "connected_context"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
