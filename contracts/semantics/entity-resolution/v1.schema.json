{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quiltor.app/contracts/semantics/entity-resolution/v1.schema.json",
  "title": "Quiltor entity-resolution golden fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["fold", "distance", "figures"],
  "properties": {
    "fold": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "expected"],
        "properties": {
          "input": { "type": "string" },
          "expected": { "type": "string" }
        }
      }
    },
    "distance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mention", "candidate", "budget", "expected"],
        "properties": {
          "mention": { "type": "string" },
          "candidate": { "type": "string" },
          "budget": { "type": "integer", "minimum": 0 },
          "expected": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "figures": {
      "$ref": "../../application-api/story-world/v1.schema.json#/$defs/storyWorld"
    }
  }
}
