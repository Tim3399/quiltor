    {
      "name": "search_world",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "required": ["worldId", "query"],
        "properties": {
          "worldId": { "type": "string" },
          "query": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 30 }
        },
        "additionalProperties": false
      },
      "example": { "worldId": "0123456789abcdef0123456789abcdef", "query": "Mara", "limit": 10 }
    },
    {
      "name": "get_world_structure",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "required": ["worldId"],
        "properties": { "worldId": { "type": "string" } },
        "additionalProperties": false
      },
      "example": { "worldId": "0123456789abcdef0123456789abcdef" }
    },
    {
      "name": "list_elements",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "required": ["worldId"],
        "properties": { "worldId": { "type": "string" } },
        "additionalProperties": false
      },
      "example": { "worldId": "0123456789abcdef0123456789abcdef" }
    },
    {
      "name": "list_relationships",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "required": ["worldId"],
        "properties": { "worldId": { "type": "string" } },
        "additionalProperties": false
      },
      "example": { "worldId": "0123456789abcdef0123456789abcdef" }
    },
    {
      "name": "get_relationship_history",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "required": ["worldId", "relationshipId"],
        "properties": { "worldId": { "type": "string" }, "relationshipId": { "type": "string" } },
        "additionalProperties": false
      },
      "example": { "worldId": "0123456789abcdef0123456789abcdef", "relationshipId": "bond" }
    },
    {
      "name": "list_timeline_moments",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "required": ["worldId"],
        "properties": { "worldId": { "type": "string" } },
        "additionalProperties": false
      },
      "example": { "worldId": "0123456789abcdef0123456789abcdef" }
    },
    {
      "name": "get_board_layout",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "required": ["worldId"],
        "properties": { "worldId": { "type": "string" } },
        "additionalProperties": false
      },
      "example": { "worldId": "0123456789abcdef0123456789abcdef" }
    },
    {
      "name": "validate_world",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "required": ["worldId"],
        "properties": { "worldId": { "type": "string" } },
        "additionalProperties": false
      },
      "example": { "worldId": "0123456789abcdef0123456789abcdef" }
    },
    {
      "name": "propose_create_element",
      "effect": "proposal",
      "inputSchema": {
        "type": "object",
        "required": ["worldId", "name"],
        "properties": {
          "worldId": { "type": "string" },
          "name": { "type": "string" },
          "type": { "enum": ["person", "tier", "ort", "organisation", "objekt", "konzept"] },
          "label": { "type": "string" },
          "sub": { "type": "string" },
          "profile": { "type": "object" }
        },
        "additionalProperties": false
      },
      "example": { "worldId": "0123456789abcdef0123456789abcdef", "name": "Mara", "type": "person" }
    },
    {
      "name": "propose_update_element",
      "effect": "proposal",
      "inputSchema": {
        "type": "object",
        "required": ["worldId", "elementId"],
        "properties": {
          "worldId": { "type": "string" },
          "elementId": { "type": "string" },
          "name": { "type": "string" },
          "label": { "type": "string" },
          "sub": { "type": "string" },
          "profile": { "type": "object" }
        },
        "additionalProperties": false
      },
      "example": {
        "worldId": "0123456789abcdef0123456789abcdef",
        "elementId": "mara",
        "label": "Kartographin"
      }
    },
    {
      "name": "propose_create_relationship",
      "effect": "proposal",
      "inputSchema": {
        "type": "object",
        "required": ["worldId", "from", "to", "label"],
        "properties": {
          "worldId": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "label": { "type": "string" },
          "directed": { "type": "boolean" },
          "style": { "enum": ["solid", "dashed", "blood", "gold"] }
        },
        "additionalProperties": false
      },
      "example": {
        "worldId": "0123456789abcdef0123456789abcdef",
        "from": "mara",
        "to": "archive",
        "label": "sucht"
      }
    },
    {
      "name": "propose_timeline_moment",
      "effect": "proposal",
      "inputSchema": {
        "type": "object",
        "required": ["worldId", "title"],
        "properties": {
          "worldId": { "type": "string" },
          "title": { "type": "string" },
          "date": { "type": "string" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      },
      "example": { "worldId": "0123456789abcdef0123456789abcdef", "title": "Ankunft" }
    },
    {
      "name": "propose_relationship_state",
      "effect": "proposal",
      "inputSchema": {
        "type": "object",
        "required": ["worldId", "relationshipId", "momentId"],
        "properties": {
          "worldId": { "type": "string" },
          "relationshipId": { "type": "string" },
          "momentId": { "type": "string" },
          "label": { "type": "string" },
          "active": { "type": "boolean" },
          "directed": { "type": "boolean" },
          "style": { "enum": ["solid", "dashed", "blood", "gold"] }
        },
        "additionalProperties": false
      },
      "example": {
        "worldId": "0123456789abcdef0123456789abcdef",
        "relationshipId": "bond",
        "momentId": "arrival",
        "active": true
      }
    },
    {
      "name": "propose_death_marker",
      "effect": "proposal",
      "inputSchema": {
        "type": "object",
        "required": ["worldId", "elementId", "momentId"],
        "properties": {
          "worldId": { "type": "string" },
          "elementId": { "type": "string" },
          "momentId": { "type": "string" }
        },
        "additionalProperties": false
      },
      "example": {
        "worldId": "0123456789abcdef0123456789abcdef",
        "elementId": "mara",
        "momentId": "arrival"
      }
    },
    {
      "name": "propose_set_presence",
      "effect": "proposal",
      "inputSchema": {
        "type": "object",
        "required": ["worldId", "elementId", "placeId"],
        "properties": {
          "worldId": { "type": "string" },
          "elementId": { "type": "string" },
          "placeId": { "type": "string" },
          "momentId": { "type": "string" }
        },
        "additionalProperties": false
      },
      "example": {
        "worldId": "0123456789abcdef0123456789abcdef",
        "elementId": "mara",
        "placeId": "archive"
      }
    },
    {
      "name": "propose_arrange_elements",
      "effect": "proposal",
      "inputSchema": {
        "type": "object",
        "required": ["worldId", "strategy"],
        "properties": {
          "worldId": { "type": "string" },
          "strategy": { "enum": ["thematic", "grid"] }
        },
        "additionalProperties": false
      },
      "example": { "worldId": "0123456789abcdef0123456789abcdef", "strategy": "grid" }
    }
  ]
}
