# Copy to .env and fill in. docker-compose.yml reads this automatically.

# Keycloak realm issuer URL of your EXISTING instance, e.g.:
# https://kc.example.com/realms/quiltor
QUILTOR_OIDC_ISSUER=

# Confidential client created in that realm for Quiltor (see README's
# "Web-Demo mit Keycloak" section for the required client settings).
QUILTOR_OIDC_CLIENT_ID=
QUILTOR_OIDC_CLIENT_SECRET=

# Public base URL this demo will be reachable at — must exactly match the
# client's registered redirect URI (${QUILTOR_PUBLIC_URL}/auth/callback).
QUILTOR_PUBLIC_URL=https://quiltor.example.com

# auto (default) marks cookies Secure based on X-Forwarded-Proto from the
# reverse proxy. Only override to 0/1 for local testing without HTTPS.
QUILTOR_COOKIE_SECURE=auto

# Host port quiltor is published on (127.0.0.1 only — see docker-compose.yml).
QUILTOR_PORT=8000

# ---------------------------------------------------------------------------
# Backup endpoint — only needed for `docker compose --profile with-backup`.
#
# This is a SECOND Keycloak client, not the one above. The app's client signs
# people in; this one signs nobody in and only asks the issuer whether an
# incoming access token is valid. Both may live in the same realm. See the
# README's "Keycloak anbinden" chapter for the client settings.
# ---------------------------------------------------------------------------

# Usually the same realm as QUILTOR_OIDC_ISSUER — it is the realm that issues
# the tokens the endpoint will be shown.
QUILTOR_BACKUP_OIDC_ISSUER=

# Confidential client for the backup server itself. Standard Flow off: these
# credentials only authenticate it to the token introspection endpoint.
QUILTOR_BACKUP_OIDC_CLIENT_ID=
QUILTOR_BACKUP_OIDC_CLIENT_SECRET=

# Public base URL the endpoint is reachable at. It is published verbatim in
# /.well-known/oauth-protected-resource, which is how a Quiltor client that was
# given nothing but this URL finds out which Keycloak to log in to.
QUILTOR_BACKUP_PUBLIC_URL=https://backup.example.com

# Scope a token must carry to be let in. A valid token is not enough — without
# this check any token from the same realm would open the endpoint, including
# one issued for an entirely different application.
QUILTOR_BACKUP_OIDC_SCOPE=quiltor.backup

# Host port the backup endpoint is published on (127.0.0.1 only).
QUILTOR_BACKUP_PORT=9000

# Baked into the image as a build arg (cosmetic LABEL only — the running
# app's /api/version always reads the VERSION file regardless of this).
QUILTOR_VERSION=2.1.0
