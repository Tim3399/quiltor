# Copy to .env and fill in. docker-compose.yml reads this automatically.

# Keycloak realm issuer URL of your EXISTING instance, e.g.:
# https://kc.example.com/realms/quiltor
QUILTOR_OIDC_ISSUER=

# Confidential client created in that realm for Quiltor (see README's
# "Web-Demo mit Keycloak" section for the required client settings).
QUILTOR_OIDC_CLIENT_ID=
QUILTOR_OIDC_CLIENT_SECRET=

# Public base URL this demo will be reachable at — must exactly match the
# client's registered redirect URI (${QUILTOR_PUBLIC_URL}/auth/callback).
QUILTOR_PUBLIC_URL=https://quiltor.example.com

# auto (default) marks cookies Secure based on X-Forwarded-Proto from the
# reverse proxy. Only override to 0/1 for local testing without HTTPS.
QUILTOR_COOKIE_SECURE=auto

# Host port quiltor is published on (127.0.0.1 only — see docker-compose.yml).
QUILTOR_PORT=8000

# Baked into the image as a build arg (cosmetic LABEL only — the running
# app's /api/version always reads the VERSION file regardless of this).
QUILTOR_VERSION=2.1.0
