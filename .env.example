# Copy to .env and fill in. docker-compose.yml reads this automatically.

# Keycloak realm issuer URL of your EXISTING instance, e.g.:
# https://kc.example.com/realms/quiltor
QUILTOR_OIDC_ISSUER=

# Confidential client created in that realm for Quiltor (see README's
# "Web-Demo mit Keycloak" section for the required client settings).
QUILTOR_OIDC_CLIENT_ID=
QUILTOR_OIDC_CLIENT_SECRET=

# Public base URL this demo will be reachable at — must exactly match the
# client's registered redirect URI (${QUILTOR_PUBLIC_URL}/auth/callback).
QUILTOR_PUBLIC_URL=https://quiltor.example.com

# auto (default) marks cookies Secure based on X-Forwarded-Proto from the
# reverse proxy. Only override to 0/1 for local testing without HTTPS.
QUILTOR_COOKIE_SECURE=auto

# Host port quiltor is published on (127.0.0.1 only — see docker-compose.yml).
QUILTOR_PORT=8000

# The realm role an account needs for the AI assistant. The realm's client scope
# quiltor-roles must put realm roles into the flat `roles` claim of the ID token.
# QUILTOR_PREMIUM_ROLE=premium

# Open assistant jobs per account, 1-100.
# QUILTOR_ASSISTANT_MAX_OPEN_JOBS=3

# Optional external AI endpoint, OpenAI-compatible (OpenAI, OpenRouter, Anthropic's
# OpenAI-compatible endpoint). A key switches it on; then no local runtime starts.
# The URL is the base without /v1 and must be https. Give the key either inline or
# as a file (a Docker secret), not both; a key without a URL stops the start.
# Uncomment QUILTOR_AI_URL and QUILTOR_AI_MODEL_NAME in docker-compose.yml as well:
# an empty value there would count as set.
# QUILTOR_AI_URL=https://api.openai.com
# QUILTOR_AI_KEY=
# QUILTOR_AI_KEY_FILE=/run/secrets/quiltor_ai_key
# QUILTOR_AI_MODEL_NAME=gpt-4o-mini
# Providers that ignore response_format: json_schema (Anthropic) need json_object.
# QUILTOR_AI_JSON_MODE=json_object

# Content Security Policy of every page. Unset means enforce (D-198). report-only only
# logs violations in the browser console -- a way out while you report a problem.
# QUILTOR_CSP=enforce
# Extra connect-src origins, space-separated, exact https:// origins (no path, no
# wildcard). Hugging Face changes its download hosts now and then: when the in-browser
# assistant stops loading its model with a CSP error, add the blocked origin here.
# QUILTOR_CSP_CONNECT_EXTRA=

# Server log (see docs/operations/logging.md). Level: DEBUG, INFO (default),
# WARNING or ERROR; anything else stops the start. The log always goes to
# stderr, which `docker compose logs quiltor` shows. A file is optional and
# rotates at 10 MiB, keeping 5 backups; inside the container it must live on a
# mounted volume, e.g. /data/quiltor-server.log.
# QUILTOR_LOG_LEVEL=INFO
# QUILTOR_LOG_FILE=

# Optional shared model folder (must already exist): gguf/*.gguf and mlx/<model>/ below it.
# Unset: models live under QUILTOR_HOME/models.
# QUILTOR_MODELS_DIR=

# Optional grammar server: a LanguageTool reachable from this container, used
# instead of a local install (the image has no Java). Chapter text is sent to
# it, so it only takes effect together with the opt-in below.
# QUILTOR_LANGUAGETOOL_URL=http://languagetool:8010
# QUILTOR_LANGUAGETOOL_EXTERNAL_OPT_IN=1

# ---------------------------------------------------------------------------
# Backup endpoint — only needed for `docker compose --profile with-backup`.
#
# This is a SECOND Keycloak client, not the one above. The app's client signs
# people in; this one signs nobody in and only asks the issuer whether an
# incoming access token is valid. Both may live in the same realm. See the
# README's "Keycloak anbinden" chapter for the client settings.
# ---------------------------------------------------------------------------

# Usually the same realm as QUILTOR_OIDC_ISSUER — it is the realm that issues
# the tokens the endpoint will be shown.
QUILTOR_BACKUP_OIDC_ISSUER=

# Confidential client for the backup server itself. Standard Flow off: these
# credentials only authenticate it to the token introspection endpoint.
QUILTOR_BACKUP_OIDC_CLIENT_ID=
QUILTOR_BACKUP_OIDC_CLIENT_SECRET=

# Public base URL the endpoint is reachable at. It is published verbatim in
# /.well-known/oauth-protected-resource, which is how a Quiltor client that was
# given nothing but this URL finds out which Keycloak to log in to.
QUILTOR_BACKUP_PUBLIC_URL=https://backup.example.com

# Scope a token must carry to be let in. A valid token is not enough — without
# this check any token from the same realm would open the endpoint, including
# one issued for an entirely different application.
QUILTOR_BACKUP_OIDC_SCOPE=quiltor.backup

# Host port the backup endpoint is published on (127.0.0.1 only).
QUILTOR_BACKUP_PORT=9000

# Baked into the image as a build arg (cosmetic LABEL only — the running
# app's /api/version always reads the VERSION file regardless of this).
QUILTOR_VERSION=2.1.0
