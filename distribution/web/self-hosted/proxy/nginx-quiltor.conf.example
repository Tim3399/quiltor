# Example nginx reverse-proxy config for the Quiltor web demo.
# Adapt to your existing TLS/vhost setup (the one already fronting Keycloak)
# and replace the placeholders.
#
# Forwarding Host and X-Forwarded-Proto is required: server.py uses them to
# build the exact OIDC redirect_uri and to decide whether to mark cookies
# Secure (see QUILTOR_PUBLIC_URL / QUILTOR_COOKIE_SECURE in the README).

server {
    listen 443 ssl;
    server_name quiltor.example.com;

    ssl_certificate     /etc/letsencrypt/live/quiltor.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/quiltor.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 80;
    server_name quiltor.example.com;
    return 301 https://$host$request_uri;
}
